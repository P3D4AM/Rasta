# ─── پیکربندی محلی رستا — نسخهٔ نمونه ───
# این فایل را به «.env» (کنار همین فایل) کپی نکنید؛
# اسکریپت Start-Rasta.ps1 در اولین اجرا خودش فایل .env را با مقادیر مناسب
# (رمز تصادفی + مسیر واقعی دیتابیس) می‌سازد. این نمونه فقط برای مستندسازی است.

# پورت اجرای برنامه (پیش‌فرض 3000 — اگر اشغال باشد پورت آزاد بعدی انتخاب می‌شود)
PORT=3000

# برنامه فقط روی رابط محلی گوش می‌دهد (دسترسی از شبکهٔ بیرونی بسته است)
HOSTNAME=127.0.0.1

# دیتابیس آزمایشی مستقل این بسته (SQLite)
# توجه: مسیر با «/» نوشته شود؛ فاصله در مسیر مجاز است ولی %20 کار نمی‌کند.
# مثال: file:C:/Users/My Name/Rasta-Dev-Windows/data/rasta.db
DATABASE_URL=file:./data/rasta.db

# راز امضای توکن ورود (JWT) — باید یک رشتهٔ تصادفی طولانی باشد.
# اسکریپت اجرا آن را خودکار تولید می‌کند. این مقدار را با هیچ‌کس به اشتراک نگذارید.
AUTH_SECRET=

  cmpTypeId               Int?      // نوع شرکت — FK به CrmCompanyType
  cmpPresentationId       Int?      // معرفی‌نامه — FK به CrmCompanyPresentation
  cmpPreTel               String?
  cmpTelUpTo              String?

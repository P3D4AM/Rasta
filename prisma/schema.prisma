// Rasta CRM — Prisma Schema
// Modern redesign of legacy CRMIdeal (EF5/EDMX, 7 contexts) into one clean schema.
// NOTE: SQLite (dev) doesn't support enums/lists/Decimal — status fields are Strings
// validated in src/lib/constants.ts; switch provider to PostgreSQL later for enums/Decimal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Identity & Access ───────────────────────────

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  firstName    String
  lastName     String
  email        String?
  phone        String?
  isAdmin      Boolean   @default(false)
  isActive     Boolean   @default(true)
  roleId       String?
  role         Role?     @relation(fields: [roleId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // ── بازسازی ستون‌های Users محصول CRMIdeal (AccountsController/UserDefine) ──
  nickName       String? // نام مستعار (Nickname)
  persCode       String? // کد پرسنلی (PersCode)
  fatherName     String? // نام پدر (FatherName)
  nationalCode   String? // کد ملی (NationalCode)
  identityNumber String? // شماره شناسنامه (IdentityNumber)
  insuranceCode  String? // کد بیمه (InsuranceCode)
  mobile         String? // موبایل (Mobile)
  mobileII       String? // موبایل دوم (MobileII)
  address        String? // نشانی (Address)
  tel            String? // تلفن (Tel)
  telDesc        String? // توضیح تلفن (TelDesc)
  description    String? // توضیحات (Description)
  userGroupId    String? // گروه کاربری (UserGroupId)
  userGroup      UserGroup? @relation(fields: [userGroupId], references: [id])
  positionId     String? // سمت سازمانی (PositionId)
  position       UserPosition? @relation(fields: [positionId], references: [id])
  departmentId   String? // دپارتمان (DepartmentInfo)
  department     UserDepartment? @relation(fields: [departmentId], references: [id])
  responsibleUserId String? // مسئول مستقیم (ResponsibleUserId)
  responsible    User?   @relation("ResponsibleUser", fields: [responsibleUserId], references: [id])
  responsibles   User[]  @relation("ResponsibleUser")
  alternativeUserIds  String? // کاربران جانشین (AlternativeUserIds — CSV)
  extensions     String? // شماره‌های داخلی تلفنی (UserExtensions)
  callPreNumber  String? // پیش‌شمارهٔ تماس خروجی (CallPreNumber)
  startDate      DateTime? // تاریخ شروع فعالیت حساب (StartDate)
  expireDate     DateTime? // تاریخ انقضای حساب — چک در ورود (ExpireDate)
  defCmpPrjTitle String? // عنوان پیش‌فرض پروژه (DefCmpPrjTitle)
  signature      Bytes? // امضای دیجیتال (UserSignature.Signature)
  disableInternalMessageAlarmVoice Boolean @default(false) // قطع صدای آلارم پیام داخلی
  disableReceiveCnvsInfoAllarm     Boolean @default(false) // قطع آلارم گفتگوهای دیگران
  accessDailyChartAllUsers Boolean @default(false) // دسترسی نمودار روزانه همه کاربران
  accessSaleChartAllUsers  Boolean @default(false) // دسترسی نمودار فروش همه کاربران

  ownedCompanies Company[]         @relation("CompanyOwner")
  ownedDeals     Deal[]            @relation("DealOwner")
  createdTasks   Task[]            @relation("TaskCreator")
  assignedTasks  Task[]            @relation("TaskAssignee")
  activities     Activity[]
  quotations     Quotation[]
  orders         SalesOrder[]
  stockMovements StockMovement[]   @relation("StockMovementUser")
  ownedPurchases PurchaseOrder[]   @relation("PurchaseOwner")
  fundCustodian  FundTransaction[] @relation("FundCustodian")
  fundVerifier   FundTransaction[] @relation("FundVerifier")
  fundCreator    FundTransaction[] @relation("FundCreator")

  // ناوینی‌های کاربر روی پروژه — مثل ۱۰ navigation کاربر CrmProjects
  startedProjects     Project[] @relation("ProjectStarter")
  finishedProjects    Project[] @relation("ProjectFinisher")
  ticketStopProjects  Project[] @relation("ProjectTicketStopper")
  readProjects        Project[] @relation("ProjectFirstReader")
  respondedProjects   Project[] @relation("ProjectFirstResponder")
  firstDoingProjects  Project[] @relation("ProjectFirstDoer")
  registeredProjects  Project[] @relation("ProjectRegistrar")
  lastEditedProjects  Project[] @relation("ProjectLastEditor")
  cnvsReferUser       ProjectConversation[] @relation("CnvsReferUser")
  cnvsRegisterUser    ProjectConversation[] @relation("CnvsRegistrar")

  loginAllowedTimes UserLoginAllowedTime[]
  bankAccounts     BankAccount[] @relation("UserBankAccounts")
}

// نقش — بازسازی CrmsysRolls (شامل سقف درصد تخفیف به تفکیک نقش)
model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  // سقف درصد تخفیف پیش‌فاکتور (LimitPreOrderDiscount*)
  limitPreOrderDiscountActive  Boolean @default(false)
  limitPreOrderDiscountPercent Float   @default(0)
  // سقف درصد تخفیف فاکتور فروش (LimitOrderDiscount*)
  limitOrderDiscountActive     Boolean @default(false)
  limitOrderDiscountPercent    Float   @default(0)
  users       User[]
  permissions RolePermission[]
}

// مجوز — بازسازی CrmsysRollPermission: نقش × فرم × اکشن (مثل خود CRMIdeal)
model RolePermission {
  id        String  @id @default(cuid())
  roleId    String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  formId    String // نام فرم مثل خود CRMIdeal: frmDefineUsers, frmPreOrder, frmDefineProjects...
  actionId  String // اکشن ریز: actView, actInsert, actEdit, actDelete, actCanSetArchive...

  @@unique([roleId, formId, actionId])
}

// ─────────────────────────── CRM Core ───────────────────────────

model Company {
  id          String   @id @default(cuid())
  name        String
  nameEn      String?
  type        String   @default("CUSTOMER") // CUSTOMER | PROSPECT | PARTNER | SUPPLIER | OTHER
  industry    String?
  taxId       String?
  econCode    String?
  phone       String?
  email       String?
  website     String?
  province    String?
  city        String?
  address     String?
  description String?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  ownerId     String?
  owner       User?    @relation("CompanyOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts       Contact[]
  deals          Deal[]
  projects       Project[]
  activities     Activity[]
  tasks          Task[]
  quotations     Quotation[]
  orders         SalesOrder[]
  purchaseOrders PurchaseOrder[] @relation("PurchaseSupplier")
}

model Contact {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  jobTitle  String?
  phone     String?
  mobile    String?
  email     String?
  isPrimary Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals      Deal[]
  activities Activity[]
  quotations Quotation[]
}

model Deal {
  id              String    @id @default(cuid())
  title           String
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact?  @relation(fields: [contactId], references: [id])
  stage           String    @default("NEW") // NEW | CONTACTED | PROPOSAL | NEGOTIATION | WON | LOST
  amount          Float?
  probability     Int?
  priority        String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  expectedCloseAt DateTime?
  closedAt        DateTime?
  closeNote       String?
  ownerId         String?
  owner           User?     @relation("DealOwner", fields: [ownerId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  activities Activity[]
  tasks      Task[]
  quotations Quotation[]
}

model Activity {
  id         String    @id @default(cuid())
  type       String    @default("NOTE") // CALL | MEETING | EMAIL | SMS | NOTE
  direction  String? // INCOMING | OUTGOING
  subject    String
  body       String?
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id])
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  occurredAt DateTime  @default(now())
  nextStep   String?
  nextAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([companyId])
  @@index([dealId])
  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueAt       DateTime?
  doneAt      DateTime?
  status      String    @default("OPEN") // OPEN | DONE | CANCELED
  priority    String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  assigneeId  String
  assignee    User      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId   String?
  creator     User?     @relation("TaskCreator", fields: [creatorId], references: [id])
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assigneeId, status])
}

// ─────────────────────────── Sales ───────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  code        String?  @unique
  unit        String   @default("عدد")
  price       Float    @default(0)
  cost        Float?
  taxRate     Float    @default(0)
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotationItems     QuotationItem[]
  orderItems         SalesOrderItem[]
  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
}

model Quotation {
  id            String    @id @default(cuid())
  number        Int       @unique
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id])
  dealId        String?
  deal          Deal?     @relation(fields: [dealId], references: [id])
  issueDate     DateTime  @default(now())
  validUntil    DateTime?
  status        String    @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED | CONVERTED
  note          String?
  ownerId       String?
  owner         User?     @relation(fields: [ownerId], references: [id])
  subtotal      Float     @default(0)
  discountTotal Float     @default(0)
  taxTotal      Float     @default(0)
  total         Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items  QuotationItem[]
  orders SalesOrder[]
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  description String?
  qty         Float     @default(1)
  unitPrice   Float     @default(0)
  discount    Float     @default(0)
  taxRate     Float     @default(0)
  lineTotal   Float     @default(0)
}

model SalesOrder {
  id            String     @id @default(cuid())
  number        Int        @unique
  quotationId   String?
  quotation     Quotation? @relation(fields: [quotationId], references: [id])
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  issueDate     DateTime   @default(now())
  status        String     @default("DRAFT") // DRAFT | ISSUED | PAID | CANCELED
  note          String?
  ownerId       String?
  owner         User?      @relation(fields: [ownerId], references: [id])
  subtotal      Float      @default(0)
  discountTotal Float      @default(0)
  taxTotal      Float      @default(0)
  total         Float      @default(0)
  paidTotal     Float      @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  items    SalesOrderItem[]
  payments Payment[]
}

model SalesOrderItem {
  id          String     @id @default(cuid())
  orderId     String
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id])
  description String?
  qty         Float      @default(1)
  unitPrice   Float      @default(0)
  discount    Float      @default(0)
  taxRate     Float      @default(0)
  lineTotal   Float      @default(0)
}

model Payment {
  id        String     @id @default(cuid())
  orderId   String
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Float
  method    String     @default("CASH") // CASH | CARD | TRANSFER | GATEWAY | CHEQUE
  paidAt    DateTime   @default(now())
  note      String?
  createdAt DateTime   @default(now())
}

// ─────────────────────────── Warehouse & Inventory (Phase 2) ───────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  location  String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLevels    StockLevel[]
  movementsFrom  StockMovement[] @relation("FromWarehouse")
  movementsTo    StockMovement[] @relation("ToWarehouse")
  purchaseOrders PurchaseOrder[]
}

model StockLevel {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Float     @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model StockMovement {
  id              String     @id @default(cuid())
  type            String // IN | OUT | TRANSFER | ADJUST
  productId       String
  product         Product    @relation(fields: [productId], references: [id])
  fromWarehouseId String?
  fromWarehouse   Warehouse? @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     Warehouse? @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  quantity        Float // IN/OUT/TRANSFER: positive; ADJUST: signed delta
  unitCost        Float?
  refType         String? // MANUAL | PURCHASE_ORDER | SALES_ORDER
  refId           String?
  note            String?
  userId          String?
  user            User?      @relation("StockMovementUser", fields: [userId], references: [id])
  movedAt         DateTime   @default(now())
  createdAt       DateTime   @default(now())

  @@index([productId])
  @@index([toWarehouseId])
  @@index([fromWarehouseId])
  @@index([refType, refId])
}

model PurchaseOrder {
  id          String     @id @default(cuid())
  number      Int        @unique
  supplierId  String
  supplier    Company    @relation("PurchaseSupplier", fields: [supplierId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  issueDate   DateTime   @default(now())
  expectedAt  DateTime?
  receivedAt  DateTime?
  status      String     @default("DRAFT") // DRAFT | ORDERED | RECEIVED | CANCELED
  note        String?
  ownerId     String?
  owner       User?      @relation("PurchaseOwner", fields: [ownerId], references: [id])
  subtotal    Float      @default(0)
  taxTotal    Float      @default(0)
  total       Float      @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  description     String?
  qty             Float         @default(1)
  unitPrice       Float         @default(0)
  taxRate         Float         @default(0)
  lineTotal       Float         @default(0)
}

// ─────────────────────────── System ───────────────────────────

model Setting {
  key   String @id
  value String
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  entity    String?
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// ─────────────────────────── Finance (فاز ۳ — بازسازی Areas/Fund + Areas/Banking + Areas/OnlinePayment) ───────────────────────────
// نگاشت: CrmFund → FundTransaction، CrmFundGroups → FundGroup،
// CrmBankingBanks/Branches/Accounts → Bank/BankBranch/BankAccount

model FundGroup {
  id        String      @id @default(cuid())
  name      String
  parentId  String?
  parent    FundGroup?  @relation("FundGroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  FundGroup[] @relation("FundGroupTree")
  order     Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  transactions FundTransaction[]
}

model FundTransaction {
  id           String    @id @default(cuid())
  number       Int       @unique // شماره سند خزانه (مثل FundNumber)
  groupId      String
  group        FundGroup @relation(fields: [groupId], references: [id])
  // کاربر خزانه‌دار (CrmUserId در محصول اصلی)
  custodianId  String
  custodian    User      @relation("FundCustodian", fields: [custodianId], references: [id])
  // RECEIVE = دریافت وجه (FundDebit) | PAY = پرداخت وجه (FundCredit)
  type         String
  amount       Float
  date         DateTime
  description  String?
  // گردش کار تایید (FundIsVerified + FundVerifierId)
  isVerified   Boolean   @default(false)
  verifiedById String?
  verifier     User?     @relation("FundVerifier", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?
  createdById  String
  createdBy    User      @relation("FundCreator", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([groupId, date])
  @@index([custodianId])
}

model Bank {
  id        String       @id @default(cuid())
  code      String? // کد بانک (BankingBankCode)
  name      String
  desc      String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  branches  BankBranch[]
}

model BankBranch {
  id        String   @id @default(cuid())
  bankId    String
  bank      Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  name      String // نام شعبه (BranchListName)
  tel       String? // تلفن شعبه (BranchListTel)
  createdAt DateTime @default(now())

  accounts BankAccount[]
}

model BankAccountType {
  id       String        @id @default(cuid())
  name     String // جاری | سپرده | قرض‌الحسنه | کوتاه‌مدت
  accounts BankAccount[]

  @@unique([name])
}

model BankAccount {
  id            String          @id @default(cuid())
  branchId      String
  branch        BankBranch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  accountTypeId String
  accountType   BankAccountType @relation(fields: [accountTypeId], references: [id])
  accountNumber String // شماره حساب (BankingAccountNumber)
  cardNumber    String? // شماره کارت (BankingAccountCardNumber)
  shabaNumber   String? // شماره شبا (BankingAccountShabaNumber)
  accountOwner  String // صاحب حساب (BankingAccountOwner)
  isDefault     Boolean         @default(false)
  desc          String?
  // حساب بانکی کاربر — بازسازی UserBankingAccounts (AccountsController.UserBankingAccounts)
  userId        String?
  user          User?           @relation("UserBankAccounts", fields: [userId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([accountNumber])
}

// ─────────────────────────── ماژول پروژه‌ها (فاز ۴) ───────────────────────────
// بازسازی faithful از CRMIdeal v3.1.18.187:
//   CrmProjects → Project، CrmConversationStatus(Group) → CnvsStatus(Group)،
//   CrmProjectTitle(Group)/Groups/Grade/Priority/Category → همین‌جا،
//   ProjectInformationTree (درختچه اطلاعات) → ProjectFieldTitle/ProjectInformation
// پروژه = پرونده/تیکت متصل به مخاطب؛ درصد پیشرفت = ProgressPercent وضعیتِ آخرین مذاکره.
// نکته: گانت/زمان‌بند/وظیفه/عضو پروژه در خود CRMIdeal وجود ندارد (مطالعه سورس) — ساخته نمی‌شود.

// سرفصل پروژه — CrmProjectTitleGroups (شامل متن توافق‌نامه/SLA و سقف تیکت هم‌جریان)
model ProjectTitleGroup {
  id           String  @id @default(cuid())
  name         String // سرفصل (ProjectTitleGroup)
  description  String? // توضیحات — در CRMIdeal با Kendo Editor + تصویر
  color         String?
  agreementActive Boolean @default(false) // نمایش توافق‌نامه (ProjectTitleGroupAgreementActive)
  agreementDesc   String? // متن توافق‌نامه/SLA (ProjectTitleGroupAgreementDesc)
  subjectDefaultContext String? // متن پیش‌فرض موضوع تیکت
  ticketAllowInCurrentCount Int? // سقف تیکت‌های هم‌زمان مجاز سرفصل
  orderView    Int     @default(0) // ترتیب نمایش
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  titles   ProjectTitle[]
  projects Project[]
}

// عنوان پیش‌فرض پروژه — CrmProjectTitles (قالب پیش‌فرض که فیلدهای فرم را پر می‌کند)
model ProjectTitle {
  id              String  @id @default(cuid())
  title           String // عنوان (ProjectTitle)
  titleGroupId    String?
  titleGroup      ProjectTitleGroup? @relation(fields: [titleGroupId], references: [id])
  statusGroupId   String? // مدل پیشرفت پیش‌فرض (ProjectTitleStatusGroupId)
  gradeId         String? // مقطع پیش‌فرض (ProjectTitleGradeId)
  priorityId      String? // اولویت پیش‌فرض (ProjectTitlePriorityId)
  description     String?
  activeNumRWithTitle Boolean @default(false) // شماره‌گذاری به تفکیک عنوان (ActivePrjNumRWithTitle)
  postFix         String? // پسوند پیش‌فرض (PrjPostFix)
  remindDay       Int? // روز یادآوری از امروز (PrjRemindDay)
  foCmpCanSee     Boolean @default(false) // نمایش در باشگاه (PrjFOCmpCanSee)
  isTicket        Boolean @default(false) // پروژه از نوع تیکت (PrjIsTicket)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  grade    ProjectGrade?   @relation(fields: [gradeId], references: [id])
  priority ProjectPriority? @relation(fields: [priorityId], references: [id])
  statusGroup CnvsStatusGroup? @relation(fields: [statusGroupId], references: [id])
}

// گروه پروژه — CrmProjectGroups
model ProjectGroup {
  id          String    @id @default(cuid())
  name        String
  description String?
  orderView   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects Project[]
}

// مقطع پروژه — CrmProjectGrade
model ProjectGrade {
  id          String    @id @default(cuid())
  name        String
  description String?
  orderView   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects  Project[]
  titles    ProjectTitle[]
}

// اولویت پروژه — CrmProjectPriority (با رنگ)
model ProjectPriority {
  id          String    @id @default(cuid())
  name        String
  color       String? // رنگ اولویت در UI (Priority.Color)
  description String?
  orderView   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects Project[]
  titles   ProjectTitle[]
}

// دسته‌بندی درختی پروژه — CrmProjectCategory (هر گره مدل پیشرفت پیش‌فرض خودش را دارد)
model ProjectCategory {
  id            String  @id @default(cuid())
  name          String
  parentId      String?
  parent        ProjectCategory? @relation("ProjectCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      ProjectCategory[] @relation("ProjectCategoryTree")
  statusGroupId String? // مدل پیشرفت پیش‌فرض دسته (CnvsStatusGroupId)
  statusGroup  CnvsStatusGroup? @relation(fields: [statusGroupId], references: [id])
  orderView     Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]
}

// مدل پیشرفت — CrmConversationStatusGroups
model CnvsStatusGroup {
  id          String    @id @default(cuid())
  name        String
  description String?
  orderView   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  statuses   CnvsStatus[]
  projects   Project[]
  categories ProjectCategory[]
  titles     ProjectTitle[]
}

// وضعیت مذاکره — CrmConversationStatus + نتیجه‌های وضعیت (CrmConversationStatusResult)
model CnvsStatus {
  id                String  @id @default(cuid())
  groupId           String
  group             CnvsStatusGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name              String
  progressPercent   Int     @default(0) // درصد پیشرفت وضعیت (ProgressPercent)
  orderView         Int     @default(0)
  // نتیجه‌های وضعیت — مثل CRMIdeal:
  prjFinished       Boolean @default(false) // نتیجه، پروژه را آرشیو می‌کند (PrjFinished)
  addPrjActive      Boolean @default(false) // نتیجه، پروژه جدید می‌سازد (AddPrjActive)
  issuePreOrderActive Boolean @default(false) // نتیجه، صدور پیش‌فاکتور (IssuePordActive)
  issueOrderActive  Boolean @default(false) // نتیجه، صدور فاکتور فروش (IssueOrdActive)
  noCnvsDup         Boolean @default(false) // مذاکره تکراری مجاز نیست (NoCnvsDup)
  isDefault         Boolean @default(false) // وضعیت پیش‌فرض درج
  isActive           Boolean @default(true)
  color             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  conversations ProjectConversation[]
}

// پروژه — بازسازی CrmProjects (پرونده/تیکت متصل به مخاطب)
model Project {
  id               String   @id @default(cuid())
  number           Int      @unique // شماره‌گذاری اتومات (prjNumR — ReservedNumber sysPart=12)
  referenceNumber  String? // شماره عطف (prjNumRef — فرمول در SP خود محصول است؛ در رستا دستی)
  postFix          String? // پسوند عنوان (prjPostFix) — یکتا به تفکیک مخاطب
  inquiryNumber    String? // شماره استعلام (prjInquiryNum)
  title            String // عنوان (prjTitle) — اجباری
  subject          String? // موضوع (prjSubject)
  description      String? // توضیح (prjDesc)
  descriptionAdditional String? // توضیح تکمیلی (prjDescI)
  titleGroupId     String?
  titleGroup       ProjectTitleGroup? @relation(fields: [titleGroupId], references: [id])
  groupId          String?
  group            ProjectGroup?   @relation(fields: [groupId], references: [id])
  gradeId          String?
  grade            ProjectGrade?   @relation(fields: [gradeId], references: [id])
  priorityId       String?
  priority         ProjectPriority? @relation(fields: [priorityId], references: [id])
  categoryId       String?
  category         ProjectCategory? @relation(fields: [categoryId], references: [id])
  statusGroupId    String // مدل پیشرفت (prjcnvsStatusGroupId) — اجباری مثل CRMIdeal
  statusGroup      CnvsStatusGroup @relation(fields: [statusGroupId], references: [id])
  companyId        String // مخاطب (prjCompanyId) — اجباری
  company          Company @relation(fields: [companyId], references: [id])
  starterUserId    String? // آغازگر (prjStarterUserId)
  starter          User?   @relation("ProjectStarter", fields: [starterUserId], references: [id])
  startDate        DateTime? // تاریخ شروع (prjStartDate)
  startDay         String? // روز شروع (prjStartDay)
  startTime        String? // ساعت شروع (prjStartTime — HH:mm:ss)
  // آرشیو (prjIsFinished + فیلدهای prjFinished*)
  isFinished       Boolean  @default(false)
  finishedDate     DateTime? // تاریخ آرشیو
  finishedDay      String?
  finishedTime    String?
  finishedUserId   String? // آرشیوکننده (prjFinishedUserId)
  finishedUser     User?   @relation("ProjectFinisher", fields: [finishedUserId], references: [id])
  finishedDurationSec Int? // مدت تا آرشیو به ثانیه (prjFinishedDuration)
  remindDate       DateTime? // تاریخ یادآوری/سررسید (prjRemindDate)
  orderView        Int? // ترتیب نمایش (prjOrderView)
  // تیکت (prjIsTicket + prjTicketStop*)
  isTicket         Boolean  @default(false)
  ticketStop       Boolean  @default(false) // توقف تیکت (prjTicketStop)
  ticketStopUserId String?
  ticketStopUser   User?   @relation("ProjectTicketStopper", fields: [ticketStopUserId], references: [id])
  ticketStopDate   DateTime?
  // باشگاه مشتریان (prjFOCmpCanSee + prjFOCmpCanInsCnvs/CanNotInsCnvs)
  foCmpCanSee     Boolean  @default(false) // نمایش برای مخاطب در باشگاه
  foCmpCanInsCnvs Boolean  @default(true) // امکان درج مذاکره از باشگاه
  userDepartmentId String? // واحد سازمانی گیرنده تیکت (prjUserDepartmentId)
  userDepartment   UserDepartment? @relation(fields: [userDepartmentId], references: [id])
  // زمان‌بندی ToDo (prjToDoTime*)
  toDoTime         DateTime? // زمان پیش‌بینی‌شده انجام
  toDoTimeRegister DateTime? // زمان ثبت پیش‌بینی
  toDoTimeDone     DateTime? // زمان تحقق
  toDoTimeSec      Int? // مدت پیش‌بینی (ثانیه)
  // SLA تیکت (prjRead*/prjResponse*/prjFirstDoing*)
  readDate         DateTime? // اولین مطالعه
  readUserId       String?
  readUser         User?   @relation("ProjectFirstReader", fields: [readUserId], references: [id])
  readDurationSec  Int?
  responseDate     DateTime? // اولین پاسخ
  responseUserId   String?
  responseUser     User?   @relation("ProjectFirstResponder", fields: [responseUserId], references: [id])
  responseDurationSec Int?
  firstDoingDate   DateTime? // اولین اقدام
  firstDoingUserId String?
  firstDoingUser   User?   @relation("ProjectFirstDoer", fields: [firstDoingUserId], references: [id])
  firstDoingDurationSec Int?
  registeredById   String? // ثبت‌کننده اولیه (prjFirstRegisterUserId)
  registeredBy     User?   @relation("ProjectRegistrar", fields: [registeredById], references: [id])
  lastEditedById   String? // آخرین ویرایشگر (UserId1)
  lastEditedBy     User?   @relation("ProjectLastEditor", fields: [lastEditedById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  conversations ProjectConversation[]

  @@index([companyId, isFinished])
  @@index([remindDate])
}

// مذاکره پروژه — بازسازی CrmConversation (هستهٔ پیشرفت: درصد پروژه از آخرین مذاکره)
model ProjectConversation {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId     String // مخاطب برای پیمایش سریع
  statusId      String
  status        CnvsStatus @relation(fields: [statusId], references: [id])
  referUserId   String? // کاربر ارجاع (cnvsReferUserId)
  referUser     User?    @relation("CnvsReferUser", fields: [referUserId], references: [id])
  cnvsDate      DateTime @default(now()) // تاریخ مذاکره
  cnvsDay       String?
  cnvsTime      String?
  description   String // متن مذاکره
  doingTimeSec  Int? // مدت انجام (ثانیه)
  registeredById String
  registeredBy  User     @relation("CnvsRegistrar", fields: [registeredById], references: [id])
  createdAt     DateTime @default(now())

  @@index([projectId, cnvsDate])
}

// ─────────────────────── ساختار سازمانی کاربران (Accounts) ───────────────────────

// سمت سازمانی — UserPositions (درخت + انتقال گروهی کاربران در CRMIdeal)
model UserPosition {
  id        String   @id @default(cuid())
  name      String // نام سمت (PositionName)
  code      String? // کد سمت (PositionCode)
  manager   String? // مدیر سمت (PositionManager)
  tel       String?
  email     String?
  address   String?
  orderView Int      @default(0)
  parentId  String?
  parent    UserPosition? @relation("PositionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  UserPosition[] @relation("PositionTree")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

// گروه کاربری — UserGroups (فقط گروه‌بندی نمایشی — در منطق مجوز استفاده نمی‌شود، مثل CRMIdeal)
model UserGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

// دپارتمان — UserDepartments
model UserDepartment {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users    User[]
  projects Project[] // تیکت‌های ارجاع‌شده به این واحد سازمانی
}

// ساعت/روز/IP مجاز ورود — UserLoginAllowedTimes (اعمال در ورود)
model UserLoginAllowedTime {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int? // ۰=شنبه … ۶=جمعه — null = هر روز
  fromDate  DateTime? // بازه تاریخ مجاز
  toDate    DateTime?
  fromTime  String // HH:mm
  toTime    String // HH:mm
  ipAddress String? // اگر خالی = هر IP
  createdAt DateTime @default(now())

  @@index([userId])
}

// پرداخت آنلاین — بازسازی Areas/OnlinePayment (ملت/پارسیان/زرین‌پال)
model OnlinePayment {
  id          String    @id @default(cuid())
  gateway     String // ZARINPAL | MELLAT | PARSIAN
  amount      Float
  description String?
  authority   String? // کد پیگیری درگاه
  status      String    @default("PENDING") // PENDING | VERIFIED | FAILED | CANCELED
  refId       String? // شماره مرجع تراکنش موفق
  orderId     String?
  payerName   String?
  payerMobile String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
}

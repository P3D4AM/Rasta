  cmpPreTelII             String?
  cmpTelII                String?
  cmpTelUpToII            String?
  cmpTelIIDesc            String?
  cmpMobile               String?
  cmpFax                  String?
  cmpFaxDesc              String?
  cmpCountryId            Int?      // FK به Country
  cmpProvinceId           Int?      // FK به Province
  cmpCityId               Int?      // FK به City
  cmpAddressDesc          String?

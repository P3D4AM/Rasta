// ═════════════════════════════════════════════════════════════════════════════════
// رستا (Rasta) — Prisma Schema v2 — «بازسازی عیناً از کاتالوگ دیتابیس CRMIdeal v3.1.18.187»
// ═════════════════════════════════════════════════════════════════════════════════
// منبع قطعی: CRMTabel.ssdl (اسکیمای ذخیره‌شده در Models.dll خود محصول) — ۶۳۳ جدول (۳۸۰ اصلی + ۲۵۳ ترجمه).
// ساختار این فایل:
//   • بخش ۱ — مدل‌های فعال اپ رستا: هر مدل با @@map/@map دقیقاً روی نام جدول/ستون اصلی نشسته و
//             همهٔ ستون‌های غایب نسخهٔ اصلی به آن افزوده شده است.
//   • بخش ۲ — مدل‌های تولیدشده برای «همهٔ جدول‌های اصلی باقی‌مانده» با نام فیلد = نام ستون اصلی،
//             نوع اصلی، و کلید اصلی identity مثل خود CRMIdeal (اتصال اپ به این جداول: فازهای بعد).
// تصمیم‌های مستند (انحراف عامدانه — عیناً، ولی بدون شکستن اپ):
//   • جدول‌های _Lang (۲۵۳) تولید نشدند — رستا فارسی-اول است؛ در صورت نیاز چندزبانه تولید می‌شوند.
//   • مدل‌های فعال، شناسهٔ رشته‌ای cuid دارند (تداوم کد فعلی) اما نام فیزیکی ستون کلید = نام اصلی
//     (مثل CompanyID/ProjectID). مدل‌های تولیدی شناسهٔ Int identity دارند مثل خود محصول.
//   • فیلدهای مخصوص رستا که معادل اصلی ندارند، بدون @map مانده‌اند و با «فقط رستا» کامنت شده‌اند.
//   • مدل‌های تولیدی فقط ستون اسکالر FK دارند (رابطه‌های Prisma فاز بعدی per-module سیم‌کشی می‌شوند).
//   • مقادیر پیش‌فرض/ایندکس‌ها/بدنهٔ SPها در SSDL نیستند — «کاتالوگ SQL» مالک دریافت شد (۵۹٬۱۲۴ دستور، جلدهای V1–V8)
//     و در این نسخه اعمال شد: ۱۲ پیش‌فرض (GUId=newid، موبایل 100/60) + ۶ ایندکس فیزیکی عیناً + ۶ ستون مهاجرتی غایب.
//     جزئیات کامل: docs/analysis/03-sql-catalog-application.md
//
// SQLite در توسعه فرم Enum/Decimal/list ندارد — وضعیت‌ها String هستند و در src/lib/constants.ts اعتبارسنجی می‌شوند؛
// برای استقرار، provider به PostgreSQL تغییر می‌کند.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════ بخش ۱ — مدل‌های فعال اپ رستا ════════════════════════════════

// ─────────────────────────── Identity & Access ───────────────────────────
// بازسازی عیناً از جدول Users خود CRMIdeal (۱۰۱ ستون) + CrmsysRolls + CrmsysRollPermission + CrmUserTasks

// کاربر — جدول اصلی: Users (۱۰۱ ستون در نسخهٔ اصلی)
model User {
  id           String    @id @default(cuid()) @map("UserId")
  username     String    @unique @map("UserName") // nvarchar(50) NOT NULL
  passwordHash String    @map("Password") // در اصل nvarchar(50) — رستا هش scrypt نگه می‌دارد (انحراف امنتی مثبت)
  firstName    String    @map("FName")
  lastName     String    @map("LName")
  email        String? // فقط رستا — در اصل ایمیل کاربر در EmailUsersInfo جدا است (جدولش در بخش ۲ حاضر است)
  phone        String? // فقط رستا — در اصل تلفن کاربر در ستون Tel
  isAdmin      Boolean   @default(false) @map("IsAdmin") // در اصل nvarchar(50) — رستا Boolean
  isActive     Boolean   @default(true) @map("IsActive")
  roleId       String? // فقط رستا — در اصل مجوز از CrmsysRollPermission/UsersPermission تخصیص می‌یابد
  role         Role?     @relation(fields: [roleId], references: [id])
  lastLoginAt  DateTime? // فقط رستا — آخرین ورود برای کارتابل
  createdAt    DateTime  @default(now()) @map("RegisterDate")
  updatedAt    DateTime  @updatedAt // فقط رستا

  // ── بازسازی ستون‌های Users محصول CRMIdeal (AccountsController/UserDefine) ──
  nickName       String? @map("Nickname")
  persCode       String? @map("PersCode")
  fatherName     String? @map("FatherName")
  nationalCode   String? @map("NationalCode")
  identityNumber String? @map("IdentityNumber")
  insuranceCode  String? @map("InsuranceCode")
  mobile         String? @map("Mobile")
  mobileII       String? @map("MobileII")
  address        String? @map("Address")
  tel            String? @map("Tel")
  telDesc        String? @map("TelDesc")
  description    String? @map("Description")
  positionId     String?  @map("PositionId")
  position       UserPosition? @relation(fields: [positionId], references: [id])
  userGroupId    String? @map("UserGroupId") // گروه کاربری — در اصل int → FK به UserGroups؛ رستا رشتهٔ cuid در همان ستون اصلی
  userGroup      UserGroup? @relation(fields: [userGroupId], references: [id])
  departmentId   String? @map("DepartmentInfo") // در اصل nvarchar(max) — رستا FK متنی به UserDepartments
  department     UserDepartment? @relation(fields: [departmentId], references: [id])
  responsibleUserId String? @map("ResponsibleUserId")
  responsible    User?   @relation("ResponsibleUser", fields: [responsibleUserId], references: [id])
  responsibles   User[]  @relation("ResponsibleUser")
  alternativeUserIds  String? @map("AlternativeUserIds") // CSV
  extensions     String? @map("UserExtensions")
  callPreNumber  String? @map("CallPreNumber")
  startDate      DateTime? @map("StartDate")
  expireDate     DateTime? @map("ExpireDate")
  defCmpPrjTitle String? @map("DefCmpPrjTitle")
  signature      Bytes? // فقط رستا — در اصل امضا در جدول UserSignature (بخش ۲) + SignatureId
  disableInternalMessageAlarmVoice Boolean @default(false) @map("DisableInternalMessageAllarmVoice")
  disableReceiveCnvsInfoAllarm     Boolean @default(false) @map("DisableReceiveCNVSInfoAllarm")
  accessDailyChartAllUsers Boolean @default(false) @map("UserAccessDailyChrtAllUsers")
  accessSaleChartAllUsers  Boolean @default(false) @map("UserAccessSaleChrtAllUsers")

  // ── ستون‌های اصلی غایب — عیناً از Users خود CRMIdeal ──
  Row                    Int?      // شماره ردیف
  UserId1                Int?      // آخرین ویرایشگر (رکورد) — در اصل int
  StartDatePersian       String?
  ExpireDatePersian      String?
  MobHRMLoginMode        Int?
  UserLoginCheckLocationType Int?
  UserLoginCheckLocations String?
  Month1                 Int?      // ماه ثبت (شمارهٔ ماه شمسی)
  RegisterDatePersian    String?   // تاریخ ثبت شمسی (nvarchar(8)) — در اصل NOT NULL
  IPAddress              String?   // آخرین IP ورود
  SignatureId            Int?      // FK به UserSignature (امضای تصویری)
  ComputerName           String?
  GUId                   String?   // شناسهٔ GUID سینک
  CallreIdDeActive       Boolean?
  CallreIdDeActiveLines  String?
  EmailAttachFileLocation String?
  AppType                String?   // نوع اپ (varchar(20))
  CanSetFree             Boolean?
  UserCIPatternFormulaPopUp String?
  UseClientNameForNetworking  Boolean?
  LanguageID             Int?
  AllowCopyOtherLanguage Boolean?
  FirstRegisterUserId    Int?      // ثبت‌کنندهٔ اولیه
  FirstRegisterDatePersian String?
  FirstRegisterDate      DateTime?
  UserIsActiveInWinApp   Boolean?
  UserIsActiveInWebApp   Boolean?
  UserIsActiveInMobApp   Boolean?
  UserIsActiveInFOSetting Boolean?
  UserIsActiveInHRM      Boolean?
  UserIsActiveInCIC      Boolean?
  CoordinateLatitude     String?
  CoordinateLongitude    String?
  CoordinateLastDate     DateTime?
  CoordinateLastDatePersian String?
  MobAppBaseInfoNeedUpdate Boolean?
  MobAppBaseInfoNeedUpdateDetail String?
  MaxNumberCmpDraft      Int?
  LinkAccUserIdStr       String?
  LinkAccUserCode        String?
  MobDeActiveAccessToLocation Boolean?
  MobAppBaseInfoLastUpdate DateTime?
  DeActiveSmartTimeAttendance Boolean?
  MobImeiCode            String?
  MobHRMImeiCode         String?
  ActiveMobMovementTracking Boolean?
  MobMovementTrackingDistanceInterval Float?   @default(100) // عیناً: DF_Users_MobMovementTrackingDistanceInterval = (100)
  MobMovementTrackingTimeInterval Int?      @default(60) // عیناً: DF_Users_MobMovementTrackingTimeInterval = (60)
  MobDeActiveScreenshot  Boolean?
  MobCallerIdDeActive    Boolean?
  MobAppDevSetting       String?
  MobUserAppUseCnt       Int?
  MobHRMUserAppUseCnt    Int?
  MobCICUserAppUseCnt    Int?
  CallerIdDeActiveFromMobile Boolean?
  ActiveDirectoryUser    String?
  LinkAccFirstTransferDate DateTime?
  LinkAccLastTransferDate DateTime?
  LinkAccData            String?
  UserCIds               String?
  UserLastCId            Int?
  UserCId                Int?
  ShiftWorkingId         Int?
  DeActiveLoginWithoutShift Boolean?
  AppLocationRequired    Boolean?
  CrmNotifDeactivInHrm   Boolean?
  LastCheckEmailDate     DateTime?

  ownedCompanies Company[]         @relation("CompanyOwner")
  ownedDeals     Deal[]            @relation("DealOwner")
  createdTasks   Task[]            @relation("TaskCreator")
  assignedTasks  Task[]            @relation("TaskAssignee")
  activities     Activity[]
  quotations     Quotation[]
  orders         SalesOrder[]
  stockMovements StockMovement[]   @relation("StockMovementUser")
  ownedPurchases PurchaseOrder[]  @relation("PurchaseOwner")
  fundCustodian  FundTransaction[] @relation("FundCustodian")
  fundVerifier   FundTransaction[] @relation("FundVerifier")
  fundCreator    FundTransaction[] @relation("FundCreator")

  // ناوینی‌های کاربر روی پروژه — مثل ۱۰ navigation کاربر CrmProjects
  startedProjects     Project[] @relation("ProjectStarter")
  finishedProjects    Project[] @relation("ProjectFinisher")
  ticketStopProjects  Project[] @relation("ProjectTicketStopper")
  readProjects        Project[] @relation("ProjectFirstReader")
  respondedProjects   Project[] @relation("ProjectFirstResponder")
  firstDoingProjects  Project[] @relation("ProjectFirstDoer")
  registeredProjects  Project[] @relation("ProjectRegistrar")
  lastEditedProjects  Project[] @relation("ProjectLastEditor")
  cnvsReferUser       ProjectConversation[] @relation("CnvsReferUser")
  cnvsRegisterUser    ProjectConversation[] @relation("CnvsRegistrar")

  loginAllowedTimes UserLoginAllowedTime[]
  bankAccounts     BankAccount[] @relation("UserBankAccounts")
  @@map("Users")  // جدول اصلی CRMIdeal: Users
}

// نقش — بازسازی CrmsysRolls (۱۳ ستون — شامل سقف درصد تخفیف به تفکیک نقش)
model Role {
  id          String           @id @default(cuid()) @map("ID")
  name        String           @unique @map("RollName")
  description String?           @map("Description")
  limitPreOrderDiscountActive  Boolean @default(false) @map("LimitPreOrderDiscountActive")
  limitPreOrderDiscountPercent Float   @default(0)     @map("LimitPreOrderDiscountPercent") // در اصل numeric
  limitOrderDiscountActive     Boolean @default(false) @map("LimitOrderDiscountActive")
  limitOrderDiscountPercent   Float   @default(0)     @map("LimitOrderDiscountPercent")
  GUId           String?
  AppType        String?
  LanguageID     Int?
  FirstRegisterUserId Int?
  FirstRegisterDatePersian String?
  FirstRegisterDate DateTime?
  users       User[]
  permissions RolePermission[]
  @@map("CrmsysRolls")  // جدول اصلی CRMIdeal: CrmsysRolls
}

// مجوز — بازسازی CrmsysRollPermission: نقش × فرم × اکشن (مثل خود CRMIdeal)
// نکتهٔ ساختاری: در اصل RollId/FormId/FormActionId هر سه int و FK به CrmsysRolls/CrmsysForms/CrmsysFormActions هستند؛
// رستا نام‌ها را رشته‌ای نگه می‌دارد (تداوم کد) — جدول‌های CrmsysForms/CrmsysFormActions در بخش ۲ حاضرند.
model RolePermission {
  id        String  @id @default(cuid()) @map("ID")
  roleId    String  @map("RollId")
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  formId    String  @map("FormId") // نام فرم مثل خود CRMIdeal: frmDefineUsers, frmPreOrder, frmDefineProjects...
  actionId  String  @map("FormActionId") // اکشن ریز: actView, actInsert, actEdit, actDelete, actCanSetArchive...
  GUId      String?
  AppType   String?
  LanguageID Int?
  FirstRegisterUserId Int?
  FirstRegisterDatePersian String?
  FirstRegisterDate DateTime?
  CId       Int?

  @@unique([roleId, formId, actionId])
  @@map("CrmsysRollPermission")  // جدول اصلی CRMIdeal: CrmsysRollPermission
}

// وظیفه — جدول اصلی: CrmUserTasks (۴۵ ستون) — کارتابل شخصی خود CRMIdeal
model Task {
  id          String    @id @default(cuid()) @map("UserTaskId")
  title       String    @map("UserTaskTitle")
  description String?   @map("UserTaskDescription")
  dueAt       DateTime? @map("UserTaskDate") // در اصل NOT NULL — برای تداوم اپ اختیاری
  doneAt      DateTime? @map("UserTaskDidItDate")
  status      String    @default("OPEN") // OPEN | DONE | CANCELED — فقط رستا؛ در اصل ستون UserTaskDidIt (bit) است
  priority    String    @default("NORMAL") // فقط رستا — در اصل UserTaskPriorityId → CrmUserTaskPriorities (بخش ۲)
  assigneeId  String    @map("UserId")
  assignee    User      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId   String?   @map("FirstRegisterUserId")
  creator     User?     @relation("TaskCreator", fields: [creatorId], references: [id])
  companyId   String?   @map("UserTaskCompanyIds") // در اصل CSV از شناسهٔ شرکت‌ها (nvarchar(2000)) — رستا تک‌مقدار
  dealId      String? // فقط رستا — اتصال به فرصت
  createdAt   DateTime  @default(now()) @map("RegisterDate")
  updatedAt   DateTime  @updatedAt // فقط رستا

  // ── ستون‌های اصلی غایب — عیناً از CrmUserTasks ──
  UserTaskDatePersian  String?  // تاریخ شمسی انجام — در اصل NOT NULL
  UserTaskTime         String?
  UserTaskGroupId      Int?     // FK به CrmUserTaskGroups (بخش ۲)
  UserTaskPriorityId   Int?     // FK به CrmUserTaskPriorities (بخش ۲)
  UserTaskShowAllarm   Int?
  UserTaskDidIt        Boolean? // انجام‌شده (bit) — معادل اصلیِ status رستا
  UserTaskRemindDate   String?
  UserTaskRemindTime   String?
  UserTaskRemindDateTime DateTime?
  UserTaskIsPublic     Boolean?
  Year1                Int?     // در اصل smallint NOT NULL
  Month1               Int?
  RegisterDatePersian  String?  // در اصل NOT NULL
  GUId                 String?   @default(uuid()) // عیناً: DF_CrmUserTasks_GUId = (newid())
  AppType              String?
  LanguageID           Int?
  FirstRegisterDatePersian String?
  FirstRegisterDate     DateTime?
  UserTaskTimeEnd      String?
  ObjectTypeId         Int?
  ObjectId             Int?
  UserTaskNoTimeOverlap Boolean?
  UserTaskRepeatDaily   Boolean?
  UserTaskRepeatWeekly  Boolean?
  UserTaskRepeatMonthly Boolean?
  UserTaskRepeatYearly  Boolean?
  UserTaskRemindRepeatDaily   Boolean?
  UserTaskRemindRepeatWeekly  Boolean?
  UserTaskRemindRepeatMonthly Boolean?
  UserTaskRemindRepeatYearly  Boolean?
  UserTaskLinkIdStr    String?
  UserTaskDateEnd      DateTime?
  UserTaskDateEndPersian String?
  UserTaskCId          Int?
  UserTaskTimeNext        String?   // عیناً V1-جدول‌ساز: [UserTaskTimeNext] [varchar](12) NULL — زمان تکرار بعدی
  UserTaskDidItDatePersian String?
  UserTaskDidItInfoJson String?

  company     Company? @relation(fields: [companyId], references: [id])
  deal        Deal?    @relation(fields: [dealId], references: [id])

  @@index([assigneeId, status])
  @@map("CrmUserTasks")  // جدول اصلی CRMIdeal: CrmUserTasks
}

// ─────────────────────────── CRM Core ───────────────────────────
// شرکت — جدول اصلی: CrmCompany (۱۲۰ ستون) | مخاطب/شخص — جدول اصلی: CrmCompanyPersons (۸۰ ستون)

model Company {
  id          String   @id @default(cuid()) @map("CompanyID")
  name        String   @map("cmpName")
  nameEn      String?  @map("cmpNameEng")
  type        String   @default("CUSTOMER") // فقط رستا — در اصل cmpTypeId → CrmCompanyType (بخش ۲)
  industry    String?  @map("cmpActivityType")
  taxId       String?  @map("cmpNationalCode") // کد ملی حقوقی (نزدیک‌ترین معادل شناسه مالیاتی)
  econCode    String?  @map("cmpEconomicCode") // کد اقتصادی
  phone       String?  @map("cmpTel")
  email       String?  @map("cmpEmail")
  website     String?  @map("cmpWebSite")
  province    String? // فقط رستا — در اصل cmpProvinceId → Province (بخش ۲)
  city        String? // فقط رستا — در اصل cmpCityId → City (بخش ۲)
  address     String?  @map("cmpAddress")
  description String?  @map("cmpDescription")
  status      String   @default("ACTIVE") // فقط رستا — در اصل ستون وضعیت جدا ندارد
  ownerId     String?  @map("cmpSuppUserId") // کارشناس مسئول/پشتیبان (cmpSuppUserId)
  owner       User?    @relation("CompanyOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now()) @map("RegisterDate")

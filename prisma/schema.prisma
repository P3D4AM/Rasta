  cmpUserName             String?   // کاربری باشگاه مشتریان
  cmpPassword             String?   // رمز باشگاه مشتریان
  cmpFirstRegisterUserId  Int?
  UserId                  Int?      // ثبت‌کنندهٔ رکورد — در اصل int NOT NULL
  Year1                   Int?      // در اصل smallint NOT NULL

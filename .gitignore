# ============================================================
# Rasta repo hygiene (2026-10-26)
# ============================================================

# secrets & credentials — هرگز کامیت نشوند
.gh_token
.gh_credentials
.gh_token.*

# local env files
.env
.env*
!.env.example

# runtime databases
/db/
*.db
*.db-journal

# environment-specific artifacts (جزو محصول نیستند)
/.zscripts/
Caddyfile
tool-results/
upload/
download/
agent-ctx/
/examples/
/mini-services/
# /tests/ حذف شد — پوشهٔ تست‌های خودمان باید کامیت شود (vitest/playwright)

# بسته خام نسخه قدیمی — برای گیت بزرگ است (محدودیت ۱۰۰MB گیت‌هاب)
# نسخه متنیِ دیکامپایل‌شده در project-analysis/decompiled/ کامیت می‌شود
project-analysis/crm-web.zip
project-analysis/crm-project/

# اسکرین‌شات‌ها به docs/screenshots منتقل شده‌اند
/rasta-*.png

# تست‌ها: مصنوعات اجرا (خروجی playwright/vitest و سرور آزمایشی)
.next-test-*/
test-results/
playwright-report/
tests/.tmp/
coverage/

# ============================================================
# Release (بستهٔ توسعه‌ای ویندوز)
# اسکریپت‌ها و راهنماها در release/ کامیت می‌شوند؛
# مصنوعات باینری (app/runtime/data/seed/logs/ZIP) با release/build-release.mjs ساخته می‌شوند
# ============================================================
/release/.cache/
/release/Rasta-Dev-Windows/app/
/release/Rasta-Dev-Windows/runtime/
/release/Rasta-Dev-Windows/data/
/release/Rasta-Dev-Windows/seed/
/release/Rasta-Dev-Windows/logs/
/release/*.zip
/release/*.sha256
